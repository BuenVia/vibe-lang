<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: lets the app talk to a backend on your computer over plain http, whether that is the
     emulator's 10.0.2.2 or your computer's LAN IP from a physical phone (e.g. http://192.168.1.47:8080/).
     Release builds use the platform default, which blocks cleartext, so the deployed API must use https. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
